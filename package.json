{
  "name": "raix-api",
  "version": "1.1.0",
  "private": true,
  "description": "API-only backend (yt-dlp + AI) plus the Telegram bot that drives it. Everything — .env, youtube.txt, caches, downloads — lives in this one folder. No root, no system install.",
  "main": "backend.js",
  "scripts": {
    "start": "node backend.js",
    "bot": "node bot/index.js",
    "check": "node -e \"require('fs').readdirSync('bot',{recursive:true}).filter(f=>f.endsWith('.js')).forEach(f=>require('child_process').execFileSync(process.execPath,['--check','bot/'+f]));console.log('syntax ok')\"",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:save": "pm2 save"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "telegraf": "^4.16.3"
  }
}
