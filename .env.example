# ============================================================
#  RaiX — backend + Telegram bot
#  Copy to .env and fill in. Both services read this one file.
# ============================================================

# ---- TELEGRAM BOT (required) -------------------------------
# Token from @BotFather
BOT_TOKEN=

# Your numeric Telegram id. Send /id to the bot to find it.
# Only this account can open the Owner Panel.
OWNER_ID=

# Optional: extra ids that also get the Owner Panel (comma separated).
# They can manage users but cannot promote, demote or restart services.
ADMIN_IDS=

# Set to true to let ANYONE use the bot. Leave false for a private bot.
OPEN_ACCESS=false

# Shown in the welcome screen.
BOT_NAME=RaiX Studio


# ---- BACKEND API -------------------------------------------
PORT=3000

# Where the bot reaches the backend. Leave as-is when both run on this Pi.
API_BASE=http://127.0.0.1:3000

# Token for the /api/admin/* publishing routes. Optional.
ADMIN_TOKEN=


# ---- AI PROVIDER -------------------------------------------
# Groq is free and fast. Get keys at https://console.groq.com/keys
# Up to 10 keys rotate automatically when one hits a rate limit.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACKS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Or use OpenRouter instead (up to 5 keys):
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY_1=
# OPENROUTER_MODEL=openrouter/auto


# ---- COOKIES -----------------------------------------------
# Folder holding youtube.txt / instagram.txt. Defaults to this folder.
# youtube.txt is also used for X, TikTok, Facebook, Vimeo, Pinterest, Snapchat.
# Upload them straight from Telegram: Owner Panel -> Cookies.
# COOKIES_DIR=/home/anonymous/Bot


# ---- BINARIES (only if auto-detection fails) ---------------
# YT_DLP_PATH=/home/anonymous/Bot/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# DENO_PATH=/home/anonymous/Bot/deno


# ---- BOT TUNING (safe defaults for a Pi 4 / 8 GB) ----------
# Telegram refuses bot uploads over 50 MB; bigger files come back as a link.
MAX_UPLOAD_MB=49

# Simultaneous heavy jobs (downloads, clips). 2 keeps a Pi 4 responsive.
MAX_CONCURRENT_JOBS=2

# Per-user rate limit: THROTTLE_MAX actions per THROTTLE_WINDOW_MS.
THROTTLE_MAX=4
THROTTLE_WINDOW_MS=1000

# How long a JSON API call may take before giving up (ms).
API_TIMEOUT_MS=180000

# Abort a transfer that stalls for this long (ms).
DOWNLOAD_IDLE_TIMEOUT_MS=240000

# error | warn | info | debug
BOT_LOG_LEVEL=info

# Working folders.
# BOT_DATA_DIR=/home/anonymous/Bot/data
# BOT_TMP_DIR=/home/anonymous/Bot/bot_tmp
# DOWNLOAD_DIR=/home/anonymous/Bot/downloads

# pm2 process names, used by the Owner Panel restart buttons.
PM2_API_NAME=raix-api
PM2_BOT_NAME=raix-bot
